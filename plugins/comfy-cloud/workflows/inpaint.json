{
  "1": {
    "class_type": "LoadImage",
    "_meta": { "title": "Xuan Source" },
    "inputs": { "image": "source.png" }
  },
  "2": {
    "class_type": "LoadImageMask",
    "_meta": { "title": "Xuan Mask" },
    "inputs": { "image": "selection.png", "channel": "red" }
  },
  "3": {
    "class_type": "PrimitiveStringMultiline",
    "_meta": { "title": "Xuan Prompt" },
    "inputs": { "value": "" }
  },
  "4": {
    "class_type": "FluxProFillNode",
    "_meta": { "title": "Flux Fill (replace with your exported inpaint node)" },
    "inputs": {
      "image": ["1", 0],
      "mask": ["2", 0],
      "prompt": ["3", 0],
      "prompt_upsampling": false,
      "guidance": 60,
      "steps": 50,
      "seed": "{{seed}}"
    }
  },
  "5": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" },
    "inputs": { "images": ["4", 0], "filename_prefix": "xuan_inpaint" }
  }
}
